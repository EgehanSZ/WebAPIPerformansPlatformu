# MongoDB Atlas bağlantı dizesi
# Atlas > Cluster > Connect > Drivers menüsünden alınır.
MONGODB_URI=mongodb+srv://<USER>:<PASS>@<CLUSTER>.mongodb.net/<DB>?retryWrites=true&w=majority

# Clerk Backend Secret Key
# Clerk Dashboard > API Keys > Secret keys bölümünden alınır.
# Format: sk_live_xxx  (production) veya sk_test_xxx (development)
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Tek bir performans testinde izin verilen maksimum istek sayısı.
MAX_REQUESTS_PER_TEST=200

# Hedef URL'ye atılan her bir HTTP isteği için zaman aşımı (ms).
REQUEST_TIMEOUT_MS=15000

# Eşzamanlı atılacak istek sayısı.
CONCURRENCY=10
